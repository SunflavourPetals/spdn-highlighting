{
  "name": "spdn-highlighting",
  "displayName": "spdn-highlighting",
  "description": "spdn highlighting",
  "version": "0.0.3",
  "icon": "./icons/spdn.png",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "spdn",
      "aliases": ["SPDN", "spdn"],
      "extensions": [".spdn"],
      "configuration": "./language-configuration.json",
      "icon": {
        "light": "./icons/spdn.svg",
        "dark": "./icons/spdn.svg"
      }
    }],
    "grammars": [{
      "language": "spdn",
      "scopeName": "source.spdn",
      "path": "./syntaxes/spdn.tmLanguage.json"
    }]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SunflavourPetals/spdn-highlighting.git"
  }
}
