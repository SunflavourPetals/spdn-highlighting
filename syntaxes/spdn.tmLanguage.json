{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPDN",
  "scopeName": "source.spdn",
  "patterns": [
    { "include": "#nested-comments" },
    { "include": "#comments" },

    { "include": "#raw-string-identifier" },
    { "include": "#error-raw-str-iden-too-many-dels" },

    { "include": "#error-str-iden-with-lf" },
    { "include": "#string-identifier" },

    { "include": "#identifier" },

    { "include": "#at-constant" },

    { "include": "#raw-string" },
    { "include": "#error-raw-str-too-many-dels" },

    { "include": "#error-str-with-lf" },
    { "include": "#string" },

    { "include": "#error-char-with-lf" },
    { "include": "#error-char-null" },
    { "include": "#char" },

    { "include": "#numeric" },

    { "include": "#operator" },
    { "include": "#punctuation" },
    { "include": "#invalid-operators" }
  ],
  "repository": {
    "nested-comments": {
      "patterns": [
        {
          "name": "comment.block.nested.spdn",
          "begin": "</",
          "end": "/>",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.nested.begin.spdn" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.nested.end.spdn" }
          },
          "patterns": [
            {
              "include": "#nested-comments"
            }
          ]
        }
      ]
    },

    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.spdn",
          "match": "//.*$"
        },
        {
          "name": "comment.block.spdn",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.block.begin.spdn" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.block.end.spdn" }
          }
        }
      ]
    },

    "raw-string-identifier": {
      "name": "entity.name.tag.raw.spdn",
      "begin": "@`([!-'\\*-\\[\\]-~]{0,16})\\(",
      "end": "\\)\\1`",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.identifier.raw.begin.spdn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.identifier.raw.end.spdn" }
      }
    },

    "error-raw-str-iden-too-many-dels": {
      "name": "invalid.illegal.spdn",
      "begin": "@`(.*?)\\(",
      "end": "\\)\\1`"
    },

    "error-str-iden-with-lf": {
      "name": "invalid.illegal.spdn",
      "match": "`[^`]*$"
    },

    "string-identifier": {
      "name": "entity.name.tag.string.spdn",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#escape-identifier" }
      ],
      "beginCaptures": {
        "0": { "name": "punctuation.definition.identifier.begin.spdn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.identifier.end.spdn" }
      }
    },

    "identifier": {
      "name": "entity.name.tag.spdn",
      "match": "[A-Za-z_\u00A8\u00AA\u00AD\u00AF\u00B2-\u00B5\u00B7-\u00BA\u00BC-\u00BE\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u00FF\u0100-\u02FF\u0370-\u167F\u1681-\u180D\u180F-\u1DBF\u1E00-\u1FFF\u200B-\u200D\u202A-\u202E\u203F-\u2040\u2054\u2060-\u206F\u2070-\u20CF\u2100-\u218F\u2460-\u24FF\u2776-\u2793\u2C00-\u2DFF\u2E80-\u2FFF\u3004-\u3007\u3021-\u302F\u3031-\u303F\u3040-\uD7FF\uF900-\uFD3D\uFD40-\uFDCF\uFDF0-\uFE1F\uFE30-\uFE44\uFE47-\uFFFD][A-Za-z0-9_\u00A8\u00AA\u00AD\u00AF\u00B2-\u00B5\u00B7-\u00BA\u00BC-\u00BE\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u00FF\u0100-\u02FF\u0370-\u167F\u1681-\u180D\u180F-\u1DBF\u1E00-\u1FFF\u200B-\u200D\u202A-\u202E\u203F-\u2040\u2054\u2060-\u206F\u2070-\u20CF\u2100-\u218F\u2460-\u24FF\u2776-\u2793\u2C00-\u2DFF\u2E80-\u2FFF\u3004-\u3007\u3021-\u302F\u3031-\u303F\u3040-\uD7FF\uF900-\uFD3D\uFD40-\uFDCF\uFDF0-\uFE1F\uFE30-\uFE44\uFE47-\uFFFD\u0300-\u036F\u1DC0-\u1DFF\u20D0-\u20FF\uFE20-\uFE2F]*"
    },

    "at-constant": {
      "name": "constant.language.at.spdn",
      "match": "@[A-Za-z_\u00A8\u00AA\u00AD\u00AF\u00B2-\u00B5\u00B7-\u00BA\u00BC-\u00BE\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u00FF\u0100-\u02FF\u0370-\u167F\u1681-\u180D\u180F-\u1DBF\u1E00-\u1FFF\u200B-\u200D\u202A-\u202E\u203F-\u2040\u2054\u2060-\u206F\u2070-\u20CF\u2100-\u218F\u2460-\u24FF\u2776-\u2793\u2C00-\u2DFF\u2E80-\u2FFF\u3004-\u3007\u3021-\u302F\u3031-\u303F\u3040-\uD7FF\uF900-\uFD3D\uFD40-\uFDCF\uFDF0-\uFE1F\uFE30-\uFE44\uFE47-\uFFFD][A-Za-z0-9_\u00A8\u00AA\u00AD\u00AF\u00B2-\u00B5\u00B7-\u00BA\u00BC-\u00BE\u00C0-\u00D6\u00D8-\u00F6\u00F8-\u00FF\u0100-\u02FF\u0370-\u167F\u1681-\u180D\u180F-\u1DBF\u1E00-\u1FFF\u200B-\u200D\u202A-\u202E\u203F-\u2040\u2054\u2060-\u206F\u2070-\u20CF\u2100-\u218F\u2460-\u24FF\u2776-\u2793\u2C00-\u2DFF\u2E80-\u2FFF\u3004-\u3007\u3021-\u302F\u3031-\u303F\u3040-\uD7FF\uF900-\uFD3D\uFD40-\uFDCF\uFDF0-\uFE1F\uFE30-\uFE44\uFE47-\uFFFD\u0300-\u036F\u1DC0-\u1DFF\u20D0-\u20FF\uFE20-\uFE2F]*"
    },

    "raw-string": {
      "name": "string.quoted.raw.spdn",
      "begin": "@\"([!-'\\*-\\[\\]-~]{0,16})\\(",
      "end": "\\)\\1\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.raw.begin.spdn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.raw.end.spdn" }
      }
    },

    "error-raw-str-too-many-dels": {
      "name": "invalid.illegal.spdn",
      "begin": "@\"(.*?)\\(",
      "end": "\\)\\1\""
    },

    "error-str-with-lf": {
      "name": "invalid.illegal.spdn",
      "match": "\"[^\"]*$"
    },

    "string": {
      "name": "string.quoted.double.spdn",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "include": "#escape" }
      ],
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.spdn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.spdn" }
      }
    },

    "error-char-with-lf": {
      "name": "invalid.illegal.spdn",
      "match": "'[^']*$"
    },
    "error-char-null": {
      "name": "invalid.illegal.spdn",
      "match": "''"
    },

    "char": {
      "name": "string.quoted.single.spdn",
      "begin": "'",
      "end": "'",
      "patterns": [
        { "include": "#escape" }
      ],
      "beginCaptures": {
        "0": { "name": "punctuation.definition.character.begin.spdn" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.character.end.spdn" }
      }
		},

    "numeric": {
      "patterns": [
        {
          "name": "constant.numeric.float.spdn",
          "match": "\\d(\\d|'\\d)*\\.(\\d(\\d|'\\d)*)?[eE][\\+\\-]?\\d(\\d|'\\d)*"
        },
        {
          "name": "constant.numeric.float.spdn",
          "match": "\\d(\\d|'\\d)*[eE][\\+\\-]?\\d(\\d|'\\d)*"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "\\d(\\d|'\\d)*\\.(\\d(\\d|'\\d)*)?[eE][\\+\\-]?"
        },
        {
          "name": "constant.numeric.float.spdn",
          "match": "\\d(\\d|'\\d)*\\.(\\d(\\d|'\\d)*)?"
        },
        {
          "name": "constant.numeric.float.spdn",
          "match": "\\.\\d(\\d|'\\d)*[eE][\\+\\-]?\\d(\\d|'\\d)*"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "\\.\\d(\\d|'\\d)*[eE][\\+\\-]?"
        },
        {
          "name": "constant.numeric.float.spdn",
          "match": "\\.\\d(\\d|'\\d)*"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "0[bB][01]([0-9]|'[0-9])*'?[2-9]([0-9]|'[0-9])*"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "0[bB][2-9]([0-9]|'[0-9])*"
        },
        {
          "name": "constant.numeric.integer.binary.spdn",
          "match": "0[bB][01]([01]|'[01])*"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "0[bB]"
        },
        {
          "name": "constant.numeric.float.hex.spdn",
          "match": "0[xX][0-9A-Fa-f]([0-9A-Fa-f]|'[0-9A-Fa-f])*(\\.([0-9A-Fa-f]([0-9A-Fa-f]|'[0-9A-Fa-f])*)?)?[pP][\\+\\-]?\\d(\\d|'\\d)*"
        },
        {
          "name": "constant.numeric.integer.hex.spdn",
          "match": "0[xX][0-9A-Fa-f]([0-9A-Fa-f]|'[0-9A-Fa-f])*"
        },
        {
          "name": "constant.numeric.float.hex.spdn",
          "match": "0[xX]\\.[0-9A-Fa-f]([0-9A-Fa-f]|'[0-9A-Fa-f])*[pP][\\+\\-]?\\d(\\d|'\\d)*"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "0[xX]"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "0([0-9]|'[0-9])*'?[89]([0-9]|'[0-9])*"
        },
        {
          "name": "constant.numeric.integer.octal.spdn",
          "match": "0([0-7]|'[0-7])*"
        },
        {
          "name": "constant.numeric.integer.spdn",
          "match": "[1-9]([0-9]|'[0-9])*"
        }
      ]
    },

    "operator": {
      "name": "keyword.operator.arithmetic.spdn",
      "match": "[+-](?=\\s*[\\d.+@-])"
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.block.spdn",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.list.spdn",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.key-value.spdn",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.spdn",
          "match": ";"
        },
        {
          "name": "punctuation.separator.list.spdn",
          "match": ","
        }
      ]
    },

    "invalid-operators": {
      "patterns": [
        {
          "name": "invalid.illegal.spdn",
          "match": "[+-](?!\\s*[\\d.+@-])"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "~|!|@|#|\\$|%|\\^|&|\\*|=|/|<|>|\\?|\\||\\\\|\\(|\\)"
        }
      ]
    },

    "escape-identifier": {
      "patterns": [
        {
          "name": "constant.character.escape.identifier.spdn",
          "match": "\\\\(?:[abfnrtv`\\\\\\?'\"]|[0-7]{1,3}|x(?:[0-9A-Fa-f]+|\\{[0-9A-Fa-f]+\\})|o\\{[0-7]+\\}|u(?:[0-9A-Fa-f]{4}|\\{[0-9A-Fa-f]+\\})|U(?:[0-9A-Fa-f]{8}|\\{[0-9A-Fa-f]+\\})|N\\{.*?\\})"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "\\\\"
        }
      ]
    },

    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.spdn",
          "match": "\\\\(?:[abfnrtv\\\\\\?'\"]|[0-7]{1,3}|x(?:[0-9A-Fa-f]+|\\{[0-9A-Fa-f]+\\})|o\\{[0-7]+\\}|u(?:[0-9A-Fa-f]{4}|\\{[0-9A-Fa-f]+\\})|U(?:[0-9A-Fa-f]{8}|\\{[0-9A-Fa-f]+\\})|N\\{.*?\\})"
        },
        {
          "name": "invalid.illegal.spdn",
          "match": "\\\\"
        }
      ]
    }
  }
}